  <div id="save-toast" class="pointer-events-none fixed bottom-24 left-1/2 z-[110] -translate-x-1/2 translate-y-5 rounded-full bg-ink px-5 py-3 text-xs font-bold text-white opacity-0 shadow-xl transition md:bottom-8" role="status" aria-live="polite">コースを保存しました</div>

  <script>
    const routeData = {
      lakeside: {
        title: "湖畔ゆっくりコース",
        time: "45–60分",
        subtitle: "赤い橋と水辺を、無理なくひと巡り。",
        stops: ["第1駐車場", "弁天橋", "弁天堂", "八橋", "第1広場"],
        note: "湖畔中心。ベビーカーは山側の散策路を避け、舗装された園路を選ぶと安心です。",
      },
      photo: {
        title: "桜と眺望コース",
        time: "約90分",
        subtitle: "湖面の光から、高台の景色へ。",
        stops: ["湖南岸", "弁天橋", "八橋", "北側散策路", "展望デッキ"],
        note: "展望デッキへは坂と階段があります。雨上がりは足元に注意してください。",
      },
      culture: {
        title: "公園と文化コース",
        time: "120–150分",
        subtitle: "自然と美術、まちの記憶をつなぐ。",
        stops: ["弁天湖", "第2広場", "美術館・郷土資料館", "展望広場", "藻原寺方面"],
        note: "施設の開館日・時間は出発前に公式情報を確認してください。",
      },
    } as const;

    type RouteKey = keyof typeof routeData;
    const selected = { time: "60", purpose: "easy" };
    let currentRoute: RouteKey = "lakeside";

    const title = document.querySelector<HTMLElement>("#planner-title");
    const time = document.querySelector<HTMLElement>("#planner-time");
    const subtitle = document.querySelector<HTMLElement>("#planner-subtitle");
    const stops = document.querySelector<HTMLOListElement>("#planner-stops");
    const note = document.querySelector<HTMLElement>("#planner-note");
    const plannerSave = document.querySelector<HTMLButtonElement>("#planner-save");
    const toast = document.querySelector<HTMLElement>("#save-toast");

    function pickRoute(): RouteKey {
      if (selected.purpose === "photo") return "photo";
      if (selected.purpose === "culture" || selected.time === "120") return "culture";
      if (selected.time === "90") return "photo";
      return "lakeside";
    }

    function renderPlanner() {
      currentRoute = pickRoute();
      const route = routeData[currentRoute];
      if (title) title.textContent = route.title;
      if (time) time.textContent = route.time;
      if (subtitle) subtitle.textContent = route.subtitle;
      if (note) note.textContent = route.note;
      if (stops) stops.innerHTML = route.stops.map((stop, index) => `<li class="flex items-center gap-3"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-vermilion text-[0.65rem] font-bold text-white">${index + 1}</span>${stop}</li>`).join("");
      if (plannerSave) {
        plannerSave.dataset.route = currentRoute;
        plannerSave.dataset.routeName = route.title;
      }
    }

    document.querySelectorAll<HTMLButtonElement>(".planner-choice").forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.dataset.group as "time" | "purpose" | undefined;
        const value = button.dataset.value;
        if (!group || !value) return;
        selected[group] = value;
        document.querySelectorAll<HTMLButtonElement>(`.planner-choice[data-group="${group}"]`).forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        renderPlanner();
      });
    });

    function showToast(message: string) {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.remove("translate-y-5", "opacity-0");
      window.setTimeout(() => toast.classList.add("translate-y-5", "opacity-0"), 1800);
    }

    function saveRoute(button: HTMLButtonElement) {
      const id = button.dataset.route;
      const name = button.dataset.routeName;
      if (!id || !name) return;
      localStorage.setItem("mobara-saved-route", JSON.stringify({ id, name, savedAt: new Date().toISOString() }));
      showToast(`${name}を保存しました`);
    }

    document.querySelectorAll<HTMLButtonElement>(".route-save, #planner-save").forEach((button) => button.addEventListener("click", () => saveRoute(button)));

    const checks = [...document.querySelectorAll<HTMLInputElement>(".spot-check")];
    const progress = document.querySelector<HTMLElement>("#check-progress");
    const message = document.querySelector<HTMLElement>("#check-message");

    function updateChecks() {
      const chosen = checks.filter((check) => check.checked).map((check) => check.value);
      localStorage.setItem("mobara-spot-list", JSON.stringify(chosen));
      if (progress) progress.textContent = `${chosen.length}/${checks.length}`;
      if (message) message.textContent = chosen.length ? `${chosen.length}か所を保存中です。` : "選んだ場所はこの端末に保存されます。";
    }

    try {
      const saved = JSON.parse(localStorage.getItem("mobara-spot-list") ?? "[]") as string[];
      checks.forEach((check) => { check.checked = saved.includes(check.value); });
    } catch { localStorage.removeItem("mobara-spot-list"); }
    updateChecks();
    checks.forEach((check) => check.addEventListener("change", updateChecks));
    document.querySelector<HTMLButtonElement>("#check-reset")?.addEventListener("click", () => { checks.forEach((check) => { check.checked = false; }); updateChecks(); showToast("行きたい場所をリセットしました"); });

    document.querySelectorAll<HTMLAnchorElement>("details nav a").forEach((link) => link.addEventListener("click", () => link.closest("details")?.removeAttribute("open")));
  </script>
</BaseLayout>
