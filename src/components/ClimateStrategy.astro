---
import SectionTitle from "./SectionTitle.astro";
import { climate } from "../data/guide";
---

<section id="climate" class="section-pad bg-[#dbe3dc]">
  <div class="container-site">
    <SectionTitle eyebrow="SEASONAL STRATEGY" title="季節ごとの過ごし方。" description="気候と見どころ、そして「どう楽しむか」をまとめた季節戦略です。" />
    <div class="mt-14 overflow-hidden rounded-[1.75rem] border border-ink/10 bg-[#f8f5ee]">
      <table class="w-full text-left text-sm">
        <thead class="bg-[#eef2ec] text-xs">
          <tr>
            <th class="px-5 py-4 font-bold">季節</th>
            <th class="px-5 py-4 font-bold">気候・服装</th>
            <th class="px-5 py-4 font-bold">見どころ</th>
            <th class="px-5 py-4 font-bold">おすすめの過ごし方</th>
          </tr>
        </thead>
        <tbody>
          {climate.map((c) => (
            <tr class="border-t border-ink/10 align-top">
              <td class="px-5 py-5"><span class="serif text-xl font-semibold">{c.season}</span><small class="mt-1 block text-[0.6rem] text-ink/45">{c.months}</small></td>
              <td class="px-5 py-5 text-xs leading-7 text-ink-soft">{c.climate}</td>
              <td class="px-5 py-5 text-xs leading-7 text-ink-soft">{c.highlight}</td>
              <td class="px-5 py-5 text-xs leading-7 text-ink-soft">{c.advice}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-5 text-xs leading-6 text-ink/65">開花や紅葉の時期は天候により前後します。</p>
  </div>
</section>
