---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}
const { eyebrow, title, description, align = "left" } = Astro.props;
---

<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center"]}>
  <p class:list={["eyebrow", align === "center" && "justify-center before:hidden"]}>{eyebrow}</p>
  <h2 class="serif mt-5 text-balance text-[clamp(2rem,4.7vw,4rem)] font-medium leading-[1.25] tracking-[0.02em] text-ink">{title}</h2>
  {description && <p class="mt-6 max-w-2xl text-sm leading-8 text-ink-soft sm:text-base">{description}</p>}
</div>
