---
import type { Route } from "../data/routes";
interface Props { route: Route }
const { route } = Astro.props;
---

<article class="group flex h-full flex-col border-t border-ink/20 pt-5">
  <div class="flex items-start justify-between gap-4">
    <span class="serif text-5xl font-light leading-none text-ink/18">{route.number}</span>
    <span class="rounded-full border border-ink/15 px-3 py-1 text-[0.65rem] font-bold tracking-[0.1em]">{route.difficulty}</span>
  </div>
  <h3 class="serif mt-8 text-2xl font-semibold tracking-[0.03em]">{route.name}</h3>
  <p class="mt-2 text-sm leading-7 text-ink-soft">{route.subtitle}</p>
  <div class="mt-7 grid grid-cols-2 gap-x-4 gap-y-5 border-y border-ink/10 py-5 text-xs">
    <div><span class="block text-[0.6rem] font-bold tracking-[0.14em] text-ink/45">TIME</span><strong class="mt-1 block text-sm">{route.time}</strong></div>
    <div><span class="block text-[0.6rem] font-bold tracking-[0.14em] text-ink/45">DISTANCE</span><strong class="mt-1 block text-sm">{route.distance}</strong></div>
  </div>
  <ol class="mt-6 flex flex-wrap gap-2" aria-label="立ち寄り場所">
    {route.stops.map((stop, index) => (
      <li class="flex items-center gap-2 text-xs font-medium"><span class="flex h-5 w-5 items-center justify-center rounded-full text-[0.58rem] text-white" style={`background:${route.color}`}>{index + 1}</span>{stop}</li>
    ))}
  </ol>
  <p class="mt-6 text-xs leading-6 text-ink-soft">{route.note}</p>
  <button class="route-save mt-auto pt-7 text-left text-xs font-bold tracking-[0.08em] text-vermilion" data-route={route.id} data-route-name={route.name}>このコースを保存 <span aria-hidden="true">＋</span></button>
</article>
